---
// お気に入り（ブラウザの localStorage に保存した仕事・発注機関・検索条件）。中身は src/scripts/favorites-page.ts が描く
import Base from '../layouts/Base.astro';

Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
---

<Base title="お気に入り" breadcrumbs={[{ label: 'お気に入り' }]} noindex>
  <h1 class="page-title">お気に入り</h1>
  <p class="page-lead">
    お気に入りは、このブラウザの中だけに保存されます（ログイン不要）。別の端末やブラウザとは共有されず、ブラウザのデータを消すと消えます。
  </p>
  <p class="unavailable" data-fav-unavailable hidden>
    このブラウザでは保存領域（localStorage）が使えないため、お気に入りを利用できません。プライベートブラウズを解除するか、サイトデータの保存を許可してください。
  </p>

  <div class="sections">
    <section class="card fav-section">
      <h2>仕事 <span class="muted count" data-fav-section-count="case"></span></h2>
      <p class="note">入札書の提出期限が近い順です。期限が過ぎた仕事は下にまとめて薄く表示します。</p>
      <ul class="fav-list" data-fav-list="case"><li class="muted">読み込み中…</li></ul>
    </section>

    <section class="card fav-section">
      <h2>発注機関 <span class="muted count" data-fav-section-count="org"></span></h2>
      <ul class="fav-list" data-fav-list="org"><li class="muted">読み込み中…</li></ul>
    </section>

    <section class="card fav-section">
      <h2>保存した条件 <span class="muted count" data-fav-section-count="search"></span></h2>
      <p class="note">上から5件の条件は、前回その条件を開いた日より後に出た仕事の数を表示します（1日1回数え直します）。</p>
      <ul class="fav-list" data-fav-list="search"><li class="muted">読み込み中…</li></ul>
    </section>

    <section class="card fav-section" id="recent" data-recent-box>
      <div class="recent-head">
        <h2>最近見た仕事</h2>
        <button type="button" class="remove" data-recent-clear hidden>記録を消す</button>
      </div>
      <p class="note">最近開いた仕事を、新しい順に20件まで、このブラウザに記録しています。</p>
      <ul class="fav-list recent-list" data-recent-list><li class="muted">読み込み中…</li></ul>
    </section>
  </div>
</Base>

<script>
  import '../scripts/favorites-page';
  import '../scripts/recent-ui';
</script>

<style>
  .sections { display: flex; flex-direction: column; gap: 20px; margin-top: 24px; }
  .fav-section { padding: 24px 28px; }
  .fav-section h2 { font-size: 18px; margin: 0 0 4px; }
  .count { font-size: 14px; font-family: var(--font-body); font-weight: 500; }
  .fav-section .note { margin: 0 0 8px; }
  .unavailable { padding: 12px 16px; border: 1px solid var(--kaki-line); background: var(--kaki-soft); color: var(--ink); border-radius: var(--radius-control); }
  .fav-list { list-style: none; padding: 0; margin: 0; }
  .fav-list :global(li) { display: flex; gap: 12px; align-items: center; padding: 12px 0; border-top: 1px solid var(--line-faint); }
  .fav-list :global(.body) { flex: 1; min-width: 0; }
  .fav-list :global(.title) { font-weight: 700; color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
  .fav-list :global(.title:hover) { color: var(--link-hover); text-decoration: underline; }
  .fav-list :global(.meta) { display: flex; flex-wrap: wrap; gap: 2px 12px; font-size: 13px; color: var(--muted); margin-top: 2px; }
  .fav-list :global(.past) { opacity: 0.55; }
  .fav-list :global(.new) { color: var(--ok); font-weight: 700; }
  .recent-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .recent-list :global(li) { flex-direction: column; align-items: stretch; gap: 0; }
  .recent-list :global(.recent-title) { font-weight: 700; color: var(--ink); text-decoration: none; overflow-wrap: anywhere; }
  .recent-list :global(.recent-title:hover) { color: var(--link-hover); text-decoration: underline; }
  .recent-list :global(.recent-meta) { font-size: 13px; color: var(--muted); }
  .recent-list :global(.is-closed) { opacity: 0.55; }
  .fav-list :global(.remove), .remove { min-height: var(--tap); padding: 0 12px; border: 1px solid var(--line-strong); border-radius: var(--radius-control); background: var(--surface); color: var(--ink-sub); font-size: 13px; cursor: pointer; white-space: nowrap; }
  @media (max-width: 600px) {
    .fav-section { padding: 20px; }
  }
</style>

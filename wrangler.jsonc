{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jimotonyusatsu",
  "account_id": "89cef33d9940786a848d14ed49fdc8d5",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // workers.dev は残す（アクセスは src/middleware.ts が本番へ 301 転送する）
  "workers_dev": true,
  // 本番ドメイン（Workers の Custom Domain。DNS レコードと証明書は Cloudflare が作る）
  "routes": [{ "pattern": "jimotonyusatsu.jp", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jimotonyusatsu",
      "database_id": "cf302650-4c73-4191-a53d-ada4b8fb5308",
      "migrations_dir": "migrations"
    }
  ],
  // エッジキャッシュ（astro.config.mjs の routeRules）
  "cache": { "enabled": true },
  "observability": {
    "enabled": true
  }
}
